{%- comment -%}
  Renders a simple price selector with up to 3 boxes:
  - Single (always)
  - Bundle (if show_volume_price)
  - Member (if show_member_price)

  Required: variant
{%- endcomment -%}
{%- liquid
  assign show_volume_price = variant.metafields.custom.show_volume_price.value
  assign show_member_price = variant.metafields.custom.show_member_price.value
  assign on_sale_for_all = variant.metafields.custom.on_sale_for_all.value

  assign prices_data = variant.metafields.custom.prices.value
  assign country_code = localization.country.iso_code
  assign country_data = prices_data[country_code]
  assign currency = country_data.currency

  assign single_tier = nil
  assign bundle_tier = nil
  for tier in country_data.none_member
    if tier.qty == 1
      assign single_tier = tier
    else
      assign bundle_tier = tier
    endif
  endfor

  assign member_single_tier = nil
  assign member_bundle_tier = nil
  for tier in country_data.member.bronze
    if tier.qty == 1
      assign member_single_tier = tier
    else
      assign member_bundle_tier = tier
    endif
  endfor

  if show_volume_price
    assign qty_bulk_size = bundle_tier.qty
    assign member_tier = member_bundle_tier
  else
    assign qty_bulk_size = 1
    assign member_tier = member_single_tier
  endif

  comment
    Ved tilbud er tier.offer_price den nedsatte pris og tier.price før-prisen —
    samme opdeling som pdp-price.liquid bruger i 'single_price_offer' og
    'bundle_price_offer'. Boksene viser den effektive pris, og før-prisen sættes
    kun når der faktisk er et tilbud, så den kan streges ud i markup'en nedenfor.
  endcomment
  assign single_price_before = nil
  assign single_price = single_tier.price
  if on_sale_for_all and single_tier.offer_price
    assign single_price = single_tier.offer_price
    assign single_price_before = single_tier.price
  endif

  assign bundle_price_before = nil
  assign bundle_price = bundle_tier.price
  if on_sale_for_all and bundle_tier.offer_price
    assign bundle_price = bundle_tier.offer_price
    assign bundle_price_before = bundle_tier.price
  endif

  comment
    Tilbudsprocenten kommer fra tier-dataen, ikke fra en egen udregning, så den
    matcher tallet den fulde visning viser for det samme produkt.
  endcomment
  capture single_save_percent
    if single_price_before
      render 'round-percent', percent: single_tier.offer_save_percent
    endif
  endcapture

  comment
    Besparelsesprocenterne regnes mod den effektive enkeltflaskepris, så et
    "SAVE x%" aldrig lover mere end kunden reelt sparer i forhold til den pris
    single-boksen viser.
  endcomment
  capture bundle_save_percent_raw
    if show_volume_price
      assign bundle_diff = single_price | minus: bundle_price | times: 100.0
      echo bundle_diff | divided_by: single_price
    endif
  endcapture
  capture bundle_save_percent
    render 'round-percent', percent: bundle_save_percent_raw
  endcapture

  capture member_save_percent_raw
    if show_member_price
      assign member_diff = single_price | minus: member_tier.price | times: 100.0
      echo member_diff | divided_by: single_price
    endif
  endcapture
  capture member_save_percent
    render 'round-percent', percent: member_save_percent_raw
  endcapture
-%}

<div class="pdp-price-simple">
  <label class="pdp-price-simple-option">
    <input type="radio" name="pdp-price-option" value="single" data-qty="1"{% unless show_volume_price or show_member_price %} checked{% endunless %}>
    <div class="pdp-price-simple-content">
      <div class="pdp-price-simple-header">
        <span class="pdp-price-simple-title">{{ 'jkl.buy_single' | t }}</span>
        {%- if single_price_before -%}
          <span class="save-badge">{{ 'jkl.on_sale_save_percent' | t: percent: single_save_percent }}</span>
        {%- endif -%}
      </div>
      {%- comment -%} Før-prisen ligger uden for prisrækken, så den får sin egen linje over tilbudsprisen {%- endcomment -%}
      {%- if single_price_before -%}
        <span class="pdp-price-simple-before">
          <span class="pdp-price-simple-before-label">{{ 'jkl.price_before' | t }}</span>
          <span class="pdp-price-simple-before-amount">{% render 'format-amount', amount: single_price_before %}</span>
        </span>
      {%- endif -%}
      <div class="pdp-price-simple-price">
        <span class="pdp-price-simple-amount">{% render 'format-amount', amount: single_price %}</span>
        <span class="pdp-price-simple-unit">{{ 'jkl.per_bottle' | t }}</span>
      </div>
    </div>
  </label>

  {%- if show_volume_price -%}
    <label class="pdp-price-simple-option">
      <input type="radio" name="pdp-price-option" value="bundle" data-qty="{{ qty_bulk_size }}"{% unless show_member_price %} checked{% endunless %}>
      <div class="pdp-price-simple-content">
        <div class="pdp-price-simple-header">
          <span class="pdp-price-simple-title">{{ 'jkl.buy_case' | t: count: qty_bulk_size }}</span>
          <span class="save-badge">{{ 'jkl.save_percent' | t: percent: bundle_save_percent }}</span>
        </div>
        {%- if bundle_price_before -%}
          <span class="pdp-price-simple-before">
            <span class="pdp-price-simple-before-label">{{ 'jkl.price_before' | t }}</span>
            <span class="pdp-price-simple-before-amount">{% render 'format-amount', amount: bundle_price_before %}</span>
          </span>
        {%- endif -%}
        <div class="pdp-price-simple-price">
          <span class="pdp-price-simple-amount">{% render 'format-amount', amount: bundle_price %}</span>
          <span class="pdp-price-simple-unit">{{ 'jkl.per_bottle' | t }}</span>
        </div>
      </div>
    </label>
  {%- endif -%}

  {%- if show_member_price -%}
    <label class="pdp-price-simple-option">
      <input type="radio" name="pdp-price-option" value="member" data-qty="{{ qty_bulk_size }}" checked>
      <div class="pdp-price-simple-content">
        <div class="pdp-price-simple-header">
          <span class="pdp-price-simple-title">{{ 'jkl.club_price' | t }}</span>
          <span class="save-badge">{{ 'jkl.save_percent' | t: percent: member_save_percent }}</span>
        </div>
        <div class="pdp-price-simple-price">
          <span class="pdp-price-simple-amount">{% render 'format-amount', amount: member_tier.price %}</span>
          <span class="pdp-price-simple-unit">{{ 'jkl.per_bottle' | t }}</span>
        </div>
      </div>
    </label>
  {%- endif -%}
</div>

<script>
  (function () {
    if (window.__pdpQtyBoxSyncInit) return;
    window.__pdpQtyBoxSyncInit = true;

    // Select the BEST price the quantity qualifies for. Among the options
    // whose threshold (data-qty) is <= the quantity, pick the cheapest by rank
    // (member/club > bundle > single). Below the bundle threshold only "single"
    // qualifies; at/above it the club price (best) wins.
    // Elements are queried at event time (document delegation) because this
    // snippet renders before the quantity field exists in the DOM.
    var PRICE_RANK = { single: 1, bundle: 2, member: 3 };

    function selectForQty() {
      var qtyInput = document.querySelector('.pdp-qty-value');
      var radios = document.querySelectorAll('input[name="pdp-price-option"]');
      if (!qtyInput || !radios.length) return;

      var qty = parseInt(qtyInput.value, 10) || 1;
      var best = null;
      var bestRank = -1;
      radios.forEach(function (r) {
        var rq = parseInt(r.getAttribute('data-qty'), 10) || 1;
        if (qty < rq) return;
        var rank = PRICE_RANK[r.value] || 0;
        if (rank > bestRank) {
          bestRank = rank;
          best = r;
        }
      });
      if (best && !best.checked) best.checked = true;
    }

    // Typing in the quantity field.
    document.addEventListener('input', function (e) {
      if (e.target.classList && e.target.classList.contains('pdp-qty-value')) selectForQty();
    });
    document.addEventListener('change', function (e) {
      if (e.target.classList && e.target.classList.contains('pdp-qty-value')) selectForQty();
    });

    // The +/- buttons set the value via inline onclick (no event fired), so
    // re-check after their click has run (bubble phase = after inline handler).
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.pdp-qty-btn')) selectForQty();
    });

    // Clicking a price box → set the quantity to that box's threshold.
    // Setting .value via JS doesn't fire input/change, so this won't loop back
    // into selectForQty (which would otherwise override the chosen box).
    document.addEventListener('change', function (e) {
      var t = e.target;
      if (!t || t.name !== 'pdp-price-option') return;
      var qtyInput = document.querySelector('.pdp-qty-value');
      var q = parseInt(t.getAttribute('data-qty'), 10);
      if (qtyInput && q) qtyInput.value = q;
    });
  })();
</script>
