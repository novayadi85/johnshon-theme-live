{%- comment -%}
  Consolidated Product JSON-LD: standard Schema.org Product fields
  (name, description, image, sku, brand, offers) + wine-specific
  fields (country, region, vintage, alcohol, volume).
  Replaces Shopify's auto-generated structured_data filter.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign vendor = product.metafields.custom.vendor.value.name | default: product.vendor -%}
{%- assign country = product.metafields.custom.country.value.name -%}
{%- assign region = product.metafields.custom.region.value.name -%}
{%- assign subregion = product.metafields.custom.sub_region.value.name -%}
{%- assign district = product.metafields.custom.district.value.name -%}
{%- assign wine_type = product.metafields.custom.type.value.type -%}
{%- assign volume = product.metafields.custom.volume -%}
{%- assign clean_description = product.description | strip_html | strip_newlines | strip -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }}
  {%- if clean_description != blank -%}
    ,"description": {{ clean_description | json }}
  {%- endif -%}
  {%- if product.featured_image -%}
    ,"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if vendor != blank -%}
    ,"brand": { "@type": "Brand", "name": {{ vendor | json }} }
  {%- endif -%}
  {%- if country != blank -%}
    ,"countryOfOrigin": {{ country | json }}
  {%- endif -%}
  ,"offers": [
    {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ shop.url | append: variant.url | json }}
        {%- if variant.sku != blank -%}
          ,"sku": {{ variant.sku | json }}
        {%- endif -%}
        {%- if variant.title != blank and variant.title != "Default Title" -%}
          ,"name": {{ variant.title | json }}
        {%- endif -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- assign first = true -%}
  {%- assign vintage = current_variant.metafields.custom.vintage -%}
  {%- assign alcohol_percentage = current_variant.metafields.custom.alcohol_percentage -%}
  ,"additionalProperty": [
    {%- if vintage != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "Vintage", "value": {{ vintage | json }} }
      {%- assign first = false -%}
    {%- endif -%}
    {%- if wine_type != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "Type", "value": {{ wine_type | json }} }
      {%- assign first = false -%}
    {%- endif -%}
    {%- if region != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "Region", "value": {{ region | json }} }
      {%- assign first = false -%}
    {%- endif -%}
    {%- if subregion != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "Sub-region", "value": {{ subregion | json }} }
      {%- assign first = false -%}
    {%- endif -%}
    {%- if district != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "District", "value": {{ district | json }} }
      {%- assign first = false -%}
    {%- endif -%}
    {%- if alcohol_percentage != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "Alcohol", "value": {{ alcohol_percentage | json }}, "unitText": "%" }
      {%- assign first = false -%}
    {%- endif -%}
    {%- if volume != blank -%}
      {% unless first %},{% endunless %}{ "@type": "PropertyValue", "name": "Volume", "value": {{ volume | json }} }
      {%- assign first = false -%}
    {%- endif -%}
  ]
}
</script>
