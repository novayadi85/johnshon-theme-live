{%- comment -%}
  SEO schema router. Detects template + collection type and renders
  the right type-specific JSON-LD snippet. Add new types by extending
  the case-blocks below.
{%- endcomment -%}

{%- liquid
  assign collection_type = collection.metafields.custom.type.value | downcase

  # WebSite-noden udsendes på alle indekserbare sider, ikke kun forsiden.
  # Cross-page @id-referencer er gyldige, men en side, der selv definerer den
  # node den peger på med isPartOf, giver en komplet graf uanset hvor
  # crawleren lander — og undgår falske advarsler fra auditværktøjer, der kun
  # ser én side ad gangen. Noden er identisk fra side til side.
  assign is_indexable = true
  if template.name == '404' or template.name == 'cart' or template.name == 'gift_card'
    assign is_indexable = false
  endif
  if template.name contains 'customers/'
    assign is_indexable = false
  endif
-%}

{%- comment -%}
  Renderes her og ikke i case-blokken nedenfor — ellers ville forsiden få
  noden to gange.
{%- endcomment -%}
{%- if is_indexable -%}
  {%- render 'seo-schema-organization' -%}
  {%- render 'seo-schema-website' -%}
{%- endif -%}

{%- case template.name -%}
  {%- when 'product' -%}
    {%- render 'seo-schema-breadcrumbs' -%}
  {%- when 'collection' -%}
    {%- case collection_type -%}
      {%- when 'vendor' -%}
        {%- comment -%} Udsender selv både CollectionPage og BreadcrumbList. {%- endcomment -%}
        {%- render 'seo-schema-vendor' -%}
      {%- else -%}
        {%- comment -%}
          CollectionPage på alle collection-sider. BreadcrumbList kun på de
          templates, der har en synlig breadcrumb: standard (jkl-plp) og tilbud
          (jkl-plp). Overview og ønskeliste har ingen, og JSON-LD uden en synlig
          sti er ugyldigt hos Google.
        {%- endcomment -%}
        {%- assign has_breadcrumb = false -%}
        {%- if template.suffix == blank or template.suffix == 'tilbud' -%}
          {%- assign has_breadcrumb = true -%}
        {%- endif -%}
        {%- render 'seo-schema-collection', has_breadcrumb: has_breadcrumb -%}
        {%- if has_breadcrumb -%}
          {%- render 'seo-schema-breadcrumbs' -%}
        {%- endif -%}
    {%- endcase -%}
{%- endcase -%}
