{%- liquid
  assign collection_type = collection.metafields.custom.type.value | downcase
  assign country_obj = collection.metafields.custom.country.value
  assign region_obj = collection.metafields.custom.region.value
  assign subregion_obj = collection.metafields.custom.subregion.value
-%}

{%- if page != blank -%}
  {%- comment -%}
    Sider har ingen kollektions-metafelter, så de får deres egen sti:
    Forside / sidens titel. page-objektet findes kun på page-templates,
    så kollektionerne nedenfor er upåvirkede.
  {%- endcomment -%}
  <div class="breadcrumbs">
    <a href="{{ routes.root_url }}">{{ 'jkl.home' | t }}</a> /
    {{ page.title }}
  </div>
{%- elsif collection_type == 'vendor' -%}
  <div class="breadcrumbs">
    <a href="/collections/all">{{ 'jkl.all_wines' | t }}</a> /
    <a href="/collections/vinproducenter">{{ 'jkl.wine_producers' | t }}</a> /
    {{ collection.title }}
  </div>
{%- else -%}
  <div class="breadcrumbs">
    <a href="/collections/all">{{ 'jkl.all_wines' | t }}</a> /
    {%- if country_obj != blank %}
      <a href="{{ country_obj.collection.value.url }}">{{ country_obj.name.value }}</a> /
    {%- endif %}
    {%- if region_obj != blank %}
      <a href="{{ region_obj.collection.value.url }}">{{ region_obj.name.value }}</a> /
    {%- endif %}
    {%- if subregion_obj != blank %}
      <a href="{{ subregion_obj.collection.value.url }}">{{ subregion_obj.name.value }}</a> /
    {%- endif %}
    {{ collection.title }}
  </div>
{%- endif -%}
