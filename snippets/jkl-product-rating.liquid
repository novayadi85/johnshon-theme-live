{%- assign rating_score = review.reviewscore | default: variant.metafields.custom.rating_score.value | default: variant.metafields.custom.rating_score | default: product.metafields.custom.rating_score.value | default: product.metafields.custom.rating_score | default: '97' -%}
{%- assign rating_label = label | default: 'Average score' -%}
{%- assign reviewer_name = review.reviewer.value.showing_name | default: variant.metafields.custom.reviewer_name.value | default: variant.metafields.custom.reviewer_name | default: product.metafields.custom.reviewer_name.value | default: product.metafields.custom.reviewer_name | default: 'Jasper Morris' -%}

<div class="rating">
  <div class="points">{{ rating_score }} Points</div>
  <div class="points-label">{{ rating_label }}</div>
  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;</div>
  <div class="reviewer">{{ reviewer_name }}</div>
</div>
