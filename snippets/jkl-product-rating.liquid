{%- assign rating_score = review.reviewscore.value | default: review.reviewscore | default: variant.metafields.custom.rating_score.value | default: variant.metafields.custom.rating_score | default: product.metafields.custom.rating_score.value | default: product.metafields.custom.rating_score -%}
{%- if rating_score != blank -%}
{%- assign reviewer_name = review.reviewer.value.showing_name | default: review.reviewer.value.name | default: variant.metafields.custom.reviewer_name.value | default: variant.metafields.custom.reviewer_name | default: product.metafields.custom.reviewer_name.value | default: product.metafields.custom.reviewer_name -%}


<div class="rating">
  <div class="points">{% render 'jkl-review-display', review: review, part: 'label' %}</div>
  {%- if label != blank -%}
    <div class="points-label">{{ label }}</div>
  {%- endif -%}
  {%- capture rating_stars %}{% render 'jkl-review-display', review: review, part: 'stars' %}{% endcapture -%}
  {%- if rating_stars != blank -%}
    <div class="stars" aria-label="{% render 'jkl-review-display', review: review, part: 'star_count' %} out of 6 stars">
      {{ rating_stars }}
    </div>
  {%- endif -%}
  {%- if reviewer_name != blank -%}
    <div class="reviewer">{{ reviewer_name }}</div>
  {%- endif -%}
</div>
{%- endif -%}
