{%- comment -%}
  Renders the bundle price variant on offer.
  Required: single_price, bundle_price, bundle_price_before, bundle_price_save_amount,
            bundle_price_save_percent, qty_bulk_size, currency
  Optional: scope (class prefix, default 'pdp')
{%- endcomment -%}
{%- assign scope = scope | default: 'pdp' -%}
<div class="{{ scope }}-pricing {{ scope }}-pricing--bundle-offer">
  <span class="{{ scope }}-save-badge">{{ 'jkl.on_sale_save_percent' | t: percent: bundle_price_save_percent }}</span>

  <div class="{{ scope }}-price-section">
    <div class="{{ scope }}-price-row">
      <span class="{{ scope }}-price">{% render 'format-amount', amount: bundle_price %}</span>
      <span class="{{ scope }}-currency">{{ currency | downcase }}</span>
      {%- unless scope == 'search' -%}
        <span class="save-badge">{{ 'jkl.save' | t }} {% render 'format-amount', amount: bundle_price_save_amount %}</span>
      {%- endunless -%}
    </div>
    {%- assign search_save_amount = bundle_price_save_amount | plus: 0 -%}
    {%- if scope == 'search' and search_save_amount > 0 -%}
      <span class="save-badge">Spar {% render 'format-amount', amount: bundle_price_save_amount %}</span>
    {%- endif -%}
    {%- assign search_qty_bulk_size = qty_bulk_size | plus: 0 -%}
    {%- if scope != 'search' or search_qty_bulk_size > 0 -%}
      <span class="{{ scope }}-club-note">
        {%- if scope == 'search' -%}
          {{ qty_bulk_size }}+ bottle
        {%- else -%}
          {{ 'jkl.price_per_bottle_bulk' | t: count: qty_bulk_size }}
        {%- endif -%}
      </span>
    {%- endif -%}
  </div>

  <div class="{{ scope }}-member-prices">
    <div class="{{ scope }}-member-price-row">
      <span class="{{ scope }}-member-value">{% render 'format-amount', amount: single_price %} {{ currency | downcase }}</span>
      <span class="{{ scope }}-member-label">{{ 'jkl.per_bottle' | t }}</span>
    </div>
    <div class="{{ scope }}-member-price-row">
      <span class="{{ scope }}-member-value">{% render 'format-amount', amount: bundle_price_before %} {{ currency | downcase }}</span>
      <span class="{{ scope }}-member-label">{{ 'jkl.at_bulk' | t: count: qty_bulk_size }}</span>
    </div>
  </div>
</div>
