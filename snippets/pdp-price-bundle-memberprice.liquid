{%- comment -%}
  Renders the bundle member price variant.
  Required: single_price, bundle_price, member_price, member_price_save_amount,
            member_price_save_percent, member_point, qty_bulk_size, currency
  Optional: scope (class prefix, default 'pdp')
{%- endcomment -%}
{%- assign scope = scope | default: 'pdp' -%}
<div class="{{ scope }}-pricing {{ scope }}-pricing--bundle-memberprice">
  <span class="{{ scope }}-save-badge">{{ 'jkl.save_percent' | t: percent: member_price_save_percent }}</span>

  <div class="{{ scope }}-price-section">
    <span class="{{ scope }}-price-label">{{ 'jkl.members_offer' | t }}</span>
    <div class="{{ scope }}-price-row">
      <span class="{{ scope }}-price">{% render 'format-amount', amount: member_price %}</span>
      <span class="{{ scope }}-currency">{{ currency | downcase }}</span>
      {%- unless scope == 'search' -%}
        <span class="save-badge">{{ 'jkl.save' | t }} {% render 'format-amount', amount: member_price_save_amount %}</span>
      {%- endunless -%}
    </div>
    {%- assign search_save_amount = member_price_save_amount | plus: 0 -%}
    {%- if scope == 'search' and search_save_amount > 0 -%}
      <span class="save-badge">{{ 'jkl.save' | t }} {% render 'format-amount', amount: member_price_save_amount %}</span>
    {%- endif -%}
    {%- assign search_qty_bulk_size = qty_bulk_size | plus: 0 -%}
    {%- comment -%}
      Klubpoint midlertidigt skjult på PDP og PLP. Search-varianten ("N+ bottle")
      er bevaret aktiv nedenfor. Tidligere markup:

      {%- if scope != 'search' or search_qty_bulk_size > 0 -%}
        <span class="{{ scope }}-club-note">
          {%- if scope == 'search' -%}
            {{ qty_bulk_size }}+ bottle
          {%- else -%}
            {{ 'jkl.earn' | t }} <span class="{{ scope }}-points-value">{% render 'format-amount', amount: member_point %}</span> {{ 'jkl.club_points' | t }}
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endcomment -%}
    {%- if scope == 'search' and search_qty_bulk_size > 0 -%}
      <span class="{{ scope }}-club-note">{{ qty_bulk_size }}+ bottle</span>
    {%- endif -%}
  </div>

  <div class="{{ scope }}-member-prices">
    <span class="{{ scope }}-price-label">{{ 'jkl.standard_prices' | t }}</span>
    <div class="{{ scope }}-member-price-row">
      <span class="{{ scope }}-member-value">{% render 'format-amount', amount: single_price %} {{ currency | downcase }}</span>
      <span class="{{ scope }}-member-label">{{ 'jkl.per_bottle' | t }}</span>
    </div>
    <div class="{{ scope }}-member-price-row">
      <span class="{{ scope }}-member-value">{% render 'format-amount', amount: bundle_price %} {{ currency | downcase }}</span>
      <span class="{{ scope }}-member-label">{{ 'jkl.at_bulk' | t: count: qty_bulk_size }}</span>
    </div>
  </div>
</div>
