<style>
  .signup-form .h-captcha { position: absolute !important; width: 0 !important; height: 0 !important; overflow: hidden !important; }
  .signup-form-errors { display: none; color: red; margin-bottom: -8px; font-size: 14px; }
  .signup-form-errors.is-visible { display: block; text-align: left; margin-bottom: 0px; }
  .signup-form-errors ul { margin: 4px 0 0; padding-left: 18px; }
  .signup-form-errors li { list-style: disc; }
</style>

{% form 'customer', class: 'signup-form' %}
  {% if customer_tags_endpoint != blank %}
    <input type="hidden" data-customer-tags-endpoint value="{{ customer_tags_endpoint | escape }}">
    <input type="hidden" data-customer-tags-shop-id value="{{ shop.permanent_domain | default: 'johnsonwine.myshopify.com' | escape }}">
    <input type="hidden" data-customer-tags-customer-id value="{% if customer %}{{ customer.id }}{% else %}1234567890{% endif %}">
    <input type="hidden" data-customer-tags-tag value="{{ customer_tags_tag | default: 'bronze' | escape }}">
    <input type="hidden" data-customer-tags-action value="{{ customer_tags_action | default: 'add' | escape }}">
    <input type="hidden" data-customer-tags-locale value="{{ request.locale.iso_code | escape }}">
  {% endif %}
  <input type="hidden" name="contact[tags]" value="newsletter,landing">
  <input type="hidden" name="contact[accepts_marketing]" value="true">
  <div class="signup-form-errors"
    data-heading="{{ error_heading }}"
    data-email-empty="{{ error_email_empty }}"
    data-email-at="{{ error_email_at }}"
    data-email-domain="{{ error_email_domain }}"
    data-email-dot="{{ error_email_dot }}"
    data-email-end="{{ error_email_end }}"
    data-consent="{{ error_consent }}">
  </div>
  <div class="signup-form-row">
    <input type="email" name="contact[email]" class="signup-form-input" placeholder="{{ placeholder }}">
    <button type="submit" class="signup-form-btn">{{ cta }}</button>
  </div>
  <label class="signup-form-consent">
    <input type="checkbox">
    <span class="signup-form-checkmark"></span>
    <span>{{ consent }}</span>
  </label>
  <p class="signup-form-success" style="display:none;"><strong>{{ success_msg }}</strong></p>
{% endform %}

<script>
  if (!window.__signupFormInit) {
    window.__signupFormInit = true;
    document.querySelectorAll('.signup-form').forEach(function(f) {
      f.setAttribute('novalidate', '');
    });
    function updateErrors(f) {
      var box = f.querySelector('.signup-form-errors');
      var emailInput = f.querySelector('input[type="email"]');
      var cb = f.querySelector('.signup-form-consent input[type="checkbox"]');
      var checkmark = f.querySelector('.signup-form-checkmark');
      var errors = [];
      var val = emailInput.value.trim();
      if (!val) {
        errors.push(box.dataset.emailEmpty);
      } else if (val.indexOf('@') === -1) {
        errors.push(box.dataset.emailAt);
      } else {
        var domain = val.split('@')[1];
        var dotPos = domain ? domain.indexOf('.') : -1;
        if (!domain || dotPos === -1) {
          errors.push(box.dataset.emailDot);
        } else if (dotPos === 0) {
          errors.push(box.dataset.emailDomain);
        } else if (domain.endsWith('.')) {
          errors.push(box.dataset.emailEnd);
        }
      }
      var emailValid = errors.length === 0;
      if (!cb.checked) {
        errors.push(box.dataset.consent);
      }
      emailInput.style.borderColor = emailValid ? '' : 'red';
      checkmark.style.borderColor = cb.checked ? '' : 'red';
      if (errors.length > 0) {
        box.innerHTML = '<strong>' + box.dataset.heading + '</strong><ul>' +
          errors.map(function(e) { return '<li>' + e + '</li>'; }).join('') + '</ul>';
        box.classList.add('is-visible');
      } else {
        box.classList.remove('is-visible');
        box.innerHTML = '';
      }
      return errors.length === 0;
    }
    document.addEventListener('change', function(e) {
      var cb = e.target;
      if (cb.type !== 'checkbox' || !cb.closest('.signup-form-consent')) return;
      var f = cb.closest('.signup-form');
      if (f.querySelector('.signup-form-errors.is-visible')) updateErrors(f);
    });
    document.addEventListener('input', function(e) {
      if (e.target.type !== 'email' || !e.target.closest('.signup-form')) return;
      var f = e.target.closest('.signup-form');
      if (f.querySelector('.signup-form-errors.is-visible')) updateErrors(f);
    });
    function submitForm(f) {
      var customerTagsEndpoint = f.querySelector('[data-customer-tags-endpoint]');
      if (customerTagsEndpoint) { 
        var localeInput = f.querySelector('[data-customer-tags-locale]');
        var locale = localeInput && localeInput.value
          ? localeInput.value
          : window.Shopify && window.Shopify.locale
            ? window.Shopify.locale
            : document.documentElement.lang || '';
        var payload = {
          method: 'update_customer_tags',
          email: f.querySelector('input[type="email"]').value.trim(),
          locale: locale,
          action: f.querySelector('[data-customer-tags-action]').value,
          tags: [f.querySelector('[data-customer-tags-tag]').value],
          metafields: [
            {
              key: 'membership',
              type: 'json',
              value: [f.querySelector('[data-customer-tags-tag]').value]
            },
            {
              key: 'has_tickets',
              type: 'number_integer',
              value: "1"
            }
          ]
        };

        f.querySelector('.signup-form-btn').disabled = true;

        fetch(customerTagsEndpoint.value, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        })
          .then(function(response) {
            return response.json().catch(function() {
              return {};
            }).then(function(data) {
              if (!response.ok || data.success === false) {
                var requestError = new Error(data.error || data.message || 'Unable to join right now. Please try again.');
                requestError.code = data.code;
                throw requestError;
              }

              return data;
            });
          })
          .then(function() {
            f.querySelector('.signup-form-row').style.display = 'none';
            f.querySelector('.signup-form-consent').style.display = 'none';
            f.querySelector('.signup-form-errors').classList.remove('is-visible');
            f.querySelector('.signup-form-success').style.display = 'block';

            window.setTimeout(function() {
              // window.location.href = '/collections/medlemmer';
            }, 2000);
          })
          .catch(function(error) {
            var box = f.querySelector('.signup-form-errors');
            var strong = document.createElement('strong');
            strong.textContent = error.message || 'Unable to join right now. Please try again.';
            box.replaceChildren(strong);
            box.classList.add('is-visible');

            if (error.code === 'customer_not_signed_in') { 
              window.setTimeout(function() {
                 window.location.href = '/account/login?return_url=' + encodeURIComponent(location.pathname);
              }, 2000);
            }
          })
          .finally(function() {
            f.querySelector('.signup-form-btn').disabled = false;
          });

        return;
      }

      var iframeName = 'signup-target-' + Date.now();
      var iframe = document.createElement('iframe');
      iframe.name = iframeName;
      iframe.style.display = 'none';
      document.body.appendChild(iframe);
      f.setAttribute('target', iframeName);
      iframe.addEventListener('load', function() {
        f.removeAttribute('target');
        iframe.remove();
        f.querySelector('.signup-form-row').style.display = 'none';
        f.querySelector('.signup-form-consent').style.display = 'none';
        f.querySelector('.signup-form-errors').classList.remove('is-visible');
        f.querySelector('.signup-form-success').style.display = 'block';
      });
      f.submit();
    }
    document.addEventListener('submit', function(e) {
      var f = e.target;
      if (!f.classList.contains('signup-form')) f = f.closest('.signup-form');
      if (!f) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (!updateErrors(f)) return;
      submitForm(f);
    }, true);
  }
</script>
