{%- comment -%}
  Valgfri overstyring af knapteksten. Sendes den ikke med, beholder
  formularen sin egen sprogtekst — så de øvrige steder den bruges
  (forside, PLP, søgning, klubbanner) er upåvirkede.
{%- endcomment -%}
{%- if cta_override != blank -%}
  {%- assign cta = cta_override -%}
{%- endif -%}
{%- comment -%}
  Tagget bruges til at afgøre, om kunden allerede er medlem (linje nedenfor).
  customer_tags_action bruges kun direkte i det skjulte felt i formularen.
{%- endcomment -%}
{%- assign customer_tags_tag_value = customer_tags_tag | default: 'bronze' -%}
{%- comment -%}
  Klubtilstanden sættes eksplicit af kalderen med member_signup: true.

  Før blev den udledt af customer_tags-parametrene (endpoint sat + tag 'bronze'
  + action 'add'), så "hvilket tag skriver vi?" og "er det her klubformularen?"
  var det samme spørgsmål. Skiftede nogen tagget til fx 'silver', ville alle
  medlemsteksterne stille og roligt forsvinde, uden at medlemslogikken var rørt.

  Kaldere uden parameteren — nyhedsbrevet på kollektions- og søgesiden — får den
  rene formular og rører aldrig medlemsdelen. Endpointet kræves stadig, da
  medlemsgrenene skriver via app-proxyen.
{%- endcomment -%}
{%- assign is_member_signup = false -%}
{%- if member_signup and customer_tags_endpoint != blank -%}
  {%- assign is_member_signup = true -%}
{%- endif -%}
{%- assign form_class = 'signup-form' -%}
{%- assign customer_join_only = false -%}
{%- assign guest_member_join = false -%}
{%- assign existing_member_join = false -%}
{%- if is_member_signup and customer and customer.tags contains customer_tags_tag_value -%}
  {%- assign existing_member_join = true -%}
  {%- assign success_msg = 'jkl.member_already' | t -%}
{%- elsif is_member_signup and customer -%}
  {%- assign customer_join_only = true -%}
  {%- assign cta = 'jkl.member_join_cta' | t -%}
  {%- assign consent = 'jkl.member_join_consent' | t -%}
  {%- assign success_msg = 'jkl.member_already' | t -%}
  {%- assign form_class = form_class | append: ' signup-form--customer-join' -%}
{%- elsif is_member_signup -%}
  {%- assign guest_member_join = true -%}
{%- endif -%}

<style>
  .signup-form .h-captcha { position: absolute !important; width: 0 !important; height: 0 !important; overflow: hidden !important; }
  .signup-form-errors { display: none; color: red; margin-bottom: -8px; font-size: 14px; }
  .signup-form-errors.is-visible { display: block; text-align: left; margin-bottom: 0px; }
  .signup-form-errors ul { margin: 4px 0 0; padding-left: 18px; }
  .signup-form-errors li { list-style: disc; }
  /* Klubbens CTA'er. Sætter selv baggrunden og læser derfor ikke
     --surface-fg, som nyhedsbrevsknappen bruger — de to kan styles hver for
     sig. */
  .signup-form-login-btn,
  .signup-form--customer-join .signup-form-btn {
    color: var(--color-cream);
    background-color: var(--color-burnt-orange);
    border-color: var(--color-burnt-orange);
  }
  .signup-form-login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .signup-form--customer-join {
    align-items: center;
  }
  .signup-form--customer-join .signup-form-btn {
    min-width: 260px;
    font-size: 14px;
  }
  .signup-form--customer-join .signup-form-consent {
    color: #000;
  }
  .signup-form-member-message {
    margin: 0;
    color: #000;
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 300;
    line-height: 1.4;
    text-align: center;
  }
</style>

{% if existing_member_join %}
  <p class="signup-form-member-message"><strong>{{ success_msg }}</strong></p>
{% elsif guest_member_join %}
  {%- assign return_path = request.path | url_encode -%}
  {%- assign login_url = routes.account_login_url | append: '?return_url=' | append: return_path -%}
  <a class="signup-form-btn signup-form-login-btn" href="{{ login_url }}">
    {{ 'jkl.member_join_login' | t }}
  </a>
{% else %}
{% form 'customer', class: form_class %}
  {% if customer_tags_endpoint != blank %}
    <input type="hidden" data-customer-tags-endpoint value="{{ customer_tags_endpoint | escape }}">
    <input type="hidden" data-customer-tags-shop-id value="{{ shop.permanent_domain | default: 'johnsonwine.myshopify.com' | escape }}">
    <input type="hidden" data-customer-tags-customer-id value="{% if customer %}{{ customer.id }}{% else %}1234567890{% endif %}">
    <input type="hidden" data-customer-tags-tag value="{{ customer_tags_tag | default: 'bronze' | escape }}">
    <input type="hidden" data-customer-tags-action value="{{ customer_tags_action | default: 'add' | escape }}">
    <input type="hidden" data-customer-tags-locale value="{{ request.locale.iso_code | escape }}">
  {% endif %}
  {% if customer_join_only and customer %}
    <input type="hidden" data-customer-tags-email value="{{ customer.email | escape }}">
  {% endif %}
  <input type="hidden" name="contact[tags]" value="newsletter,landing">
  <input type="hidden" name="contact[accepts_marketing]" value="true">
  <div class="signup-form-errors"
    data-heading="{{ error_heading }}"
    data-email-empty="{{ error_email_empty }}"
    data-email-at="{{ error_email_at }}"
    data-email-domain="{{ error_email_domain }}"
    data-email-dot="{{ error_email_dot }}"
    data-email-end="{{ error_email_end }}"
    data-consent="{{ error_consent }}">
  </div>
  <div class="signup-form-row">
    {% unless customer_join_only %}
      <input type="email" name="contact[email]" class="signup-form-input" placeholder="{{ placeholder }}">
    {% endunless %}
    <button type="submit" class="signup-form-btn">{{ cta }}</button>
  </div>
  <label class="signup-form-consent">
    <input type="checkbox">
    <span class="signup-form-checkmark"></span>
    <span>{{ consent }}</span>
  </label>
  <p class="signup-form-success" style="display:none;"><strong>{{ success_msg }}</strong></p>
{% endform %}
{% endif %}

<script>
  if (!window.__signupFormInit) {
    window.__signupFormInit = true;
    document.querySelectorAll('.signup-form').forEach(function(f) {
      f.setAttribute('novalidate', '');
    });
    function updateErrors(f) {
      var box = f.querySelector('.signup-form-errors');
      var emailInput = f.querySelector('input[type="email"]');
      var cb = f.querySelector('.signup-form-consent input[type="checkbox"]');
      var checkmark = f.querySelector('.signup-form-checkmark');
      var errors = [];
      var emailValid = true;
      if (emailInput) {
        var val = emailInput.value.trim();
        if (!val) {
          errors.push(box.dataset.emailEmpty);
        } else if (val.indexOf('@') === -1) {
          errors.push(box.dataset.emailAt);
        } else {
          var domain = val.split('@')[1];
          var dotPos = domain ? domain.indexOf('.') : -1;
          if (!domain || dotPos === -1) {
            errors.push(box.dataset.emailDot);
          } else if (dotPos === 0) {
            errors.push(box.dataset.emailDomain);
          } else if (domain.endsWith('.')) {
            errors.push(box.dataset.emailEnd);
          }
        }
        emailValid = errors.length === 0;
      }
      if (!cb.checked) {
        errors.push(box.dataset.consent);
      }
      if (emailInput) emailInput.style.borderColor = emailValid ? '' : 'red';
      checkmark.style.borderColor = cb.checked ? '' : 'red';
      if (errors.length > 0) {
        box.innerHTML = '<strong>' + box.dataset.heading + '</strong><ul>' +
          errors.map(function(e) { return '<li>' + e + '</li>'; }).join('') + '</ul>';
        box.classList.add('is-visible');
      } else {
        box.classList.remove('is-visible');
        box.innerHTML = '';
      }
      return errors.length === 0;
    }
    document.addEventListener('change', function(e) {
      var cb = e.target;
      if (cb.type !== 'checkbox' || !cb.closest('.signup-form-consent')) return;
      var f = cb.closest('.signup-form');
      if (f.querySelector('.signup-form-errors.is-visible')) updateErrors(f);
    });
    document.addEventListener('input', function(e) {
      if (e.target.type !== 'email' || !e.target.closest('.signup-form')) return;
      var f = e.target.closest('.signup-form');
      if (f.querySelector('.signup-form-errors.is-visible')) updateErrors(f);
    });
    function submitForm(f) {
      var customerTagsEndpoint = f.querySelector('[data-customer-tags-endpoint]');
      if (customerTagsEndpoint) { 
        var localeInput = f.querySelector('[data-customer-tags-locale]');
        var locale = localeInput && localeInput.value
          ? localeInput.value
          : window.Shopify && window.Shopify.locale
            ? window.Shopify.locale
            : document.documentElement.lang || '';
        var payload = {
          method: 'update_customer_tags',
          email: (f.querySelector('input[type="email"]') || f.querySelector('[data-customer-tags-email]')).value.trim(),
          locale: locale,
          action: f.querySelector('[data-customer-tags-action]').value,
          tags: [f.querySelector('[data-customer-tags-tag]').value],
          metafields: [
            {
              key: 'membership',
              type: 'json',
              value: [f.querySelector('[data-customer-tags-tag]').value]
            },
            {
              key: 'has_tickets',
              type: 'number_integer',
              value: "1"
            }
          ]
        };

        f.querySelector('.signup-form-btn').disabled = true;

        fetch(customerTagsEndpoint.value, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        })
          .then(function(response) {
            return response.json().catch(function() {
              return {};
            }).then(function(data) {
              if (!response.ok || data.success === false) {
                var requestError = new Error(data.error || data.message || 'Unable to join right now. Please try again.');
                requestError.code = data.code;
                throw requestError;
              }

              return data;
            });
          })
          .then(function(resp) {
            
            f.querySelector('.signup-form-row').style.display = 'none';
            f.querySelector('.signup-form-consent').style.display = 'none';
            f.querySelector('.signup-form-errors').classList.remove('is-visible');
            f.querySelector('.signup-form-success').style.display = 'block';

            if(resp?.mode == 'simple'){
              window.setTimeout(function() {
                window.location.href = '/collections/medlemmer';
              }, 2000);
            }
            
          })
          .catch(function(error) {
            var box = f.querySelector('.signup-form-errors');
            var strong = document.createElement('strong');
            strong.textContent = error.message || 'Unable to join right now. Please try again.';
            box.replaceChildren(strong);
            box.classList.add('is-visible');

            if (error.code === 'customer_not_signed_in') { 
              window.setTimeout(function() {
                 window.location.href = '/account/login?return_url=' + encodeURIComponent(location.pathname);
              }, 2000);
            }
          })
          .finally(function() {
            f.querySelector('.signup-form-btn').disabled = false;
          });

        return;
      }

      var iframeName = 'signup-target-' + Date.now();
      var iframe = document.createElement('iframe');
      iframe.name = iframeName;
      iframe.style.display = 'none';
      document.body.appendChild(iframe);
      f.setAttribute('target', iframeName);
      iframe.addEventListener('load', function() {
        f.removeAttribute('target');
        iframe.remove();
        f.querySelector('.signup-form-row').style.display = 'none';
        f.querySelector('.signup-form-consent').style.display = 'none';
        f.querySelector('.signup-form-errors').classList.remove('is-visible');
        f.querySelector('.signup-form-success').style.display = 'block';
      });
      f.submit();
    }
    document.addEventListener('submit', function(e) {
      var f = e.target;
      if (!f.classList.contains('signup-form')) f = f.closest('.signup-form');
      if (!f) return;
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (!updateErrors(f)) return;
      submitForm(f);
    }, true);
  }
</script>
