<!-- === Reviews === -->
{%- if matching_reviews.size > 0 -%}
{{ 'jkl-review-drawer.js' | asset_url | script_tag }}

<section class="pdp-reviews bg-olive color-cream">
  <p class="pdp-section-label">{{ 'jkl.ratings_and_reviews' | t }}</p>
  <h2 class="pdp-section-title title">What Trusted Wine Critics Say About This Wine</h2>
  <div class="pdp-reviews-grid">
    {%- for review in matching_reviews -%}
      <article class="pdp-review-card">
        <span class="pdp-review-score">{% render 'jkl-review-display', review: review, part: 'label' %}</span>
        {%- capture card_stars %}{% render 'jkl-review-display', review: review, part: 'stars' %}{% endcapture -%}
        {%- if card_stars != blank -%}
          <span class="pdp-review-stars" aria-label="{% render 'jkl-review-display', review: review, part: 'star_count' %} out of 6 stars">{{ card_stars }}</span>
        {%- endif -%}
        <span class="pdp-review-critic">{{ review.reviewer.value.showing_name | default: review.reviewer.value.name }}</span>
        <span class="pdp-review-vintage">Vintage {{ review.vintage }}</span>
        <p class="pdp-review-text">{{ review.reviewtext | metafield_tag | truncate: 200 }}</p>
        <button type="button" class="pdp-review-link" data-review-drawer-open data-review-index="{{ forloop.index0 }}">Read full review</button>
      </article>
    {%- endfor -%}
  </div>
  <div class="pdp-review-drawer" data-review-drawer aria-hidden="true">
    <button type="button" class="pdp-review-drawer__backdrop" data-review-drawer-close aria-label="Close reviews"></button>
    <aside class="pdp-review-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="pdp-review-drawer-title" tabindex="-1">
      <div class="pdp-review-drawer__header">
        <div class="pdp-review-drawer__title-row">
          <h2 id="pdp-review-drawer-title" class="pdp-review-drawer__title">Reviews</h2>
          {%- if matching_reviews.size > 0 -%}
            {%- assign drawer_total_score = 0 -%}
            {%- for review in matching_reviews -%}
              {%- assign review_score = review.reviewscore.value | default: review.reviewscore | plus: 0 -%}
              {%- assign review_type = review.reviewtype.value | default: review.reviewtype | default: 'Points (value 0 to 100)' -%}
              {%- assign review_type_handle = review_type | handleize -%}
              {%- if review_type_handle contains 'star' -%}
                {%- assign normalized_review_score = review_score | times: 100 | divided_by: 6 -%}
              {%- elsif review_type_handle contains '20' -%}
                {%- assign normalized_review_score = review_score | times: 5 -%}
              {%- else -%}
                {%- assign normalized_review_score = review_score -%}
              {%- endif -%}
              {%- assign drawer_total_score = drawer_total_score | plus: normalized_review_score -%}
            {%- endfor -%}
            {%- assign drawer_average_score = drawer_total_score | divided_by: matching_reviews.size | round -%}
            <span class="pdp-review-drawer__average">Average {{ drawer_average_score }} Points</span>
          {%- endif -%}
        </div>
        <button type="button" class="pdp-review-drawer__close" data-review-drawer-close aria-label="Close reviews">×</button>
      </div>
      <div class="pdp-review-drawer__content">
        {%- for review in matching_reviews -%}
          <article class="pdp-review-drawer__item" data-review-drawer-item="{{ forloop.index0 }}">
            <span class="pdp-review-drawer__score">{% render 'jkl-review-display', review: review, part: 'label' %}</span>
            <span class="pdp-review-drawer__critic">{{ review.reviewer.value.showing_name | default: review.reviewer.value.name }}</span>
            <span class="pdp-review-drawer__vintage">Vintage {{ review.vintage }}</span>
            <div class="pdp-review-drawer__text">{{ review.reviewtext | metafield_tag }}</div>
          </article>
        {%- endfor -%}
      </div>
      <button type="button" class="pdp-review-drawer__bottom-close" data-review-drawer-close aria-label="Close reviews">×</button>
    </aside>
  </div>
</section>
{%- endif -%}

