{%- liquid
  # Sproghåndtering ligger i sektionen: ét felt pr. sprog pr. tekst, valgt ud fra
  # det aktive storefront-sprog. Der er bevidst ingen fallback — står feltet tomt
  # på det sprog kunden ser siden på, udelades teksten helt.
  assign lang = request.locale.iso_code

  assign key = 'subtitle_' | append: lang
  assign hero_subtitle = section.settings[key]

  assign key = 'title_' | append: lang
  assign hero_title = section.settings[key]

  assign key = 'button_label_' | append: lang
  assign hero_button_label = section.settings[key]

  assign key = 'sticker_' | append: lang
  assign hero_sticker = section.settings[key]

  assign key = 'right_subtitle_' | append: lang
  assign hero_right_subtitle = section.settings[key]

  assign key = 'right_description_' | append: lang
  assign hero_right_description = section.settings[key]
-%}
<section class="hero color-cream">
  <div class="hero-left">
    <img src="https://cdn.shopify.com/s/files/1/0945/9030/4603/files/vin-i-glas.png?v=1773217500" alt="Wine being poured into glass">
    <div class="hero-left-content">
      {%- if hero_subtitle != blank -%}
        <p class="hero-subtitle">{{ hero_subtitle }}</p>
      {%- endif -%}
      {%- if hero_title != blank -%}
        <h1 class="hero-title">{{ hero_title }}</h1>
      {%- endif -%}
      {%- if hero_button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn-primary">{{ hero_button_label }}</a>
      {%- endif -%}
    </div>
  </div>
  {%- if hero_sticker != blank -%}
    <div class="hero-sticker">
      <span>{{ hero_sticker }}</span>
    </div>
  {%- endif -%}
  <div class="hero-right">
    <img class="hero-bg" src="https://cdn.shopify.com/s/files/1/0945/9030/4603/files/marker.png?v=1773217359" alt="Vineyard">
    <div class="hero-right-content">
      {%- if hero_right_subtitle != blank -%}
        <p class="subtitle">{{ hero_right_subtitle }}</p>
      {%- endif -%}
      {%- if hero_right_description != blank -%}
        <p class="description">{{ hero_right_description }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

