{% assign lang = request.locale.iso_code %}
{% assign headline_key = 'headline_' | append: lang %}
{% assign subtitle_key = 'subtitle_' | append: lang %}
{% assign intro_key = 'intro_' | append: lang %}
{% assign cta_text_key = 'cta_text_' | append: lang %}
{% assign bullets_key = 'bullets_' | append: lang %}
{% assign bullets = section.settings[bullets_key] | split: ',' %}

<section id="signup-section" class="signup-with-text-2 {{ section.settings.background_class | default: 'bg-cream-color' }} {{ section.settings.text_class | default: 'text-black-color' }}">
  <div class="signup-with-text-2-inner">
    <h2 class="title">{{ section.settings[headline_key] }}</h2>
    {% if section.settings[subtitle_key] != blank %}
      <p>{{ section.settings[subtitle_key] }}</p>
    {% endif %}
    {% if bullets[0] != blank %}
      <p>{{ section.settings[intro_key] }}</p>
      <ul class="signup-with-text-2-producers">
        {% for bullet in bullets %}
          <li>
            <svg class="signup-with-text-2-check" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 8l6 6L20 2" stroke="#1a1914" stroke-width="1.5"></path></svg>
            <span>{{ bullet | strip }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if section.settings[cta_text_key] != blank %}
      <p>{{ section.settings[cta_text_key] }}</p>
    {% endif %}
    {% if section.settings.show_form %}
     {% render 'jkl-signup-form' %}
    {% endif %}
  </div>
</section>

{% schema %}
