      "default": "Där hantverk och människor formar vinet"
    },
    {
      "type": "text",
      "id": "button_label_sv",
      "label": "Button label",
      "default": "Möt producenten"
    },
    {
      "type": "header",
      "content": "Deutsch (de)"
    },
    {
      "type": "text",
      "id": "label_de",
      "label": "Label"
    },
    {
      "type": "text",
      "id": "title_de",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "button_label_de",
      "label": "Button label"
    },
    {
      "type": "header",
      "content": "Polski (pl)"
    },
    {
      "type": "text",
      "id": "label_pl",
      "label": "Label"
    },
    {
      "type": "text",
      "id": "title_pl",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "button_label_pl",
      "label": "Button label"
    },
    {
      "type": "header",
      "content": "English (en)"
    },
    {
      "type": "text",
      "id": "label_en",
      "label": "Label",
      "default": "Meet the producers"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title",
      "default": "Where craftsmanship and people shape wine"
    },
    {
      "type": "text",
      "id": "button_label_en",
      "label": "Button label",
      "default": "Meet the producer"
    }
  ],
  "presets": [
    {
      "name": "JKL Story Carousel"
    }
  ]
