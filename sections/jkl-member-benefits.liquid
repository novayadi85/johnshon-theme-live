{%- comment -%}
  Sektion til "Bliv medlem"-siden. Indholdet bygges af blokke, så redaktøren
  frit kan blande overskrifter, brødtekst og fordelslister i vilkårlig rækkefølge.

  Sproghåndtering følger samme mønster som jkl-club-banner: ét felt pr. sprog
  pr. tekst, valgt ud fra det aktive storefront-sprog. Ingen fallback — er
  feltet tomt for det aktive sprog, udelades blokken helt.
{%- endcomment -%}
{%- assign lang = request.locale.iso_code -%}

<section class="jkl-member-benefits">
  <div class="jkl-member-benefits__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'heading' -%}
          {%- assign key = 'text_' | append: lang -%}
          {%- assign heading = block.settings[key] -%}
          {%- if heading != blank -%}
            <h2 class="jkl-member-benefits__heading" {{ block.shopify_attributes }}>{{ heading | escape }}</h2>
          {%- endif -%}

        {%- when 'text' -%}
          {%- assign key = 'text_' | append: lang -%}
          {%- assign body = block.settings[key] -%}
          {%- if body != blank -%}
            <div class="jkl-member-benefits__rte rte" {{ block.shopify_attributes }}>{{ body }}</div>
          {%- endif -%}

        {%- when 'benefits' -%}
          {%- assign key = 'items_' | append: lang -%}
          {%- assign items_raw = block.settings[key] -%}
          {%- if items_raw != blank -%}
            {%- comment -%}
              Ét punkt pr. linje. newline_to_br gør linjeskiftet til et token vi
              kan splitte på, så både \n og \r\n håndteres; strip renser resten.
            {%- endcomment -%}
            {%- assign items = items_raw | newline_to_br | split: '<br />' -%}
            <ul class="jkl-member-benefits__list" {{ block.shopify_attributes }}>
              {%- for item in items -%}
                {%- assign label = item | strip -%}
                {%- if label != blank -%}
                  <li class="jkl-member-benefits__item">
                    <svg class="jkl-member-benefits__check" width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                      <path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ label | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

        {%- when 'signup' -%}
          {%- comment -%}
            Samme formular som på forsiden. Gated som i jkl-club-banner og
            jkl-plp: eksisterende bronze-medlemmer får den ikke vist.
          {%- endcomment -%}
          {%- unless customer.tags contains 'bronze' -%}
            {%- assign key = 'title_' | append: lang -%}
            {%- assign signup_title = block.settings[key] -%}
            {%- assign key = 'button_' | append: lang -%}
            {%- assign signup_button = block.settings[key] -%}
            <div class="jkl-member-benefits__signup" {{ block.shopify_attributes }}>
              {%- if signup_title != blank -%}
                <h3 class="jkl-member-benefits__signup-title">{{ signup_title | escape }}</h3>
              {%- endif -%}
              {% render 'jkl-signup-form',
                customer_tags_endpoint: '/apps/communication',
                customer_tags_tag: 'bronze',
                customer_tags_action: 'add',
                cta_override: signup_button
              %}
            </div>
          {%- endunless -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

