{%- comment -%}
  JKL 404 page content (header + footer come from the layout groups).
  Built to the Figma spec: watermark logo-mark + "404" + "Page not found"
  (Gascogne Xlight 64) + Homepage button (burgundy).
{%- endcomment -%}
<section class="jkl-404">
  <div class="jkl-404__watermark" aria-hidden="true">
    <svg viewBox="0 0 60 93" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
      <path d="M57.5108 6.98598e-07H1.37169C0.613706 6.98598e-07 0.00149109 0.60734 0.00149109 1.35928V2.50648C0.00149109 3.25842 0.613706 3.86576 1.37169 3.86576H55.0814C55.645 3.86576 56.1114 4.31886 56.1114 4.88763V53.87C56.1114 54.622 55.4992 55.2293 54.7412 55.2293H33.304C32.546 55.2293 31.9338 54.622 31.9338 53.87V10.1802C31.9338 8.81124 30.8163 7.71224 29.4461 7.71224H24.6844C24.1014 7.71224 23.5377 7.94361 23.1296 8.35814L6.23053 25.4118C5.37537 26.2795 3.88857 25.6721 3.88857 24.4574V9.06188C3.88857 8.30994 3.27635 7.7026 2.51837 7.7026H1.36197C0.613706 7.71224 0.00149109 8.31958 0.00149109 9.07152V57.3984C0.00149109 58.1503 0.613706 58.7576 1.37169 58.7576H2.52809C3.28607 58.7576 3.89829 58.1503 3.89829 57.3984V39.4963C3.89829 38.2816 5.38509 37.6839 6.24025 38.5419L47.6959 80.3519C48.2401 80.9014 48.211 81.798 47.6279 82.3185C42.9828 86.5506 36.8024 89.1342 30.0097 89.1342C16.0745 89.1342 4.65626 78.2503 3.93716 64.5997C3.89829 63.867 3.31522 63.2789 2.56696 63.2789H1.41056C0.623423 63.2789 0.0112088 63.9441 0.0500795 64.725C0.837212 80.4387 13.9755 92.9807 30.0097 92.9807C46.4521 92.9807 59.843 79.7831 59.9985 63.5103V63.2211V2.46792C59.9985 1.10864 58.881 6.98598e-07 57.5108 6.98598e-07ZM28.0565 51.7491C28.0565 52.9638 26.5697 53.5615 25.7145 52.7035L6.11392 32.9313C5.58916 32.4011 5.58916 31.5623 6.11392 31.0321L25.7145 11.2599C26.5697 10.3922 28.0565 10.9996 28.0565 12.2143V51.7588V51.7491ZM56.1114 61.3123V63.2404C56.1114 68.2726 54.6538 72.9771 52.1369 76.9489C51.6607 77.6912 50.6112 77.8165 49.9893 77.1899L34.2855 61.3798C33.4401 60.5218 34.0523 59.0758 35.2573 59.0758H54.7412C55.4992 59.0758 56.1114 59.6831 56.1114 60.4351V61.3123Z"/>
    </svg>
  </div>

  <div class="jkl-404__content">
    <div class="jkl-404__text">
      <p class="jkl-404__code">404</p>
      <h1 class="jkl-404__title">Page not found</h1>
    </div>
    <a href="{{ routes.root_url }}" class="jkl-404__btn">Homepage</a>
  </div>
</section>

<style>
  .jkl-404 {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    padding: 96px 24px;
    overflow: hidden;
    background: var(--color-background);
  }

  /* Watermark: Figma 936×1451 (aspect 60:93), centred, faint gold */
  .jkl-404__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 936px;
    max-width: 90%;
    opacity: 0.1;
    pointer-events: none;
    z-index: 0;
  }

  .jkl-404__watermark svg {
    display: block;
    width: 100%;
    height: auto;
    fill: var(--color-green-gold);
  }

  .jkl-404__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;                 /* Figma: text block → button */
  }

  .jkl-404__text {
    display: flex;
    flex-direction: column;
    gap: 12px;                 /* Figma: 404 → title */
    text-align: center;
    color: var(--color-burgundy);
  }

  .jkl-404__code {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    margin: 0;
  }

  .jkl-404__title {
    font-family: 'Gascogne', serif;
    font-weight: 250;          /* Figma: Xlight */
    font-size: 64px;
    line-height: 1;
    margin: 0;
  }

  .jkl-404__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 40px 10px;   /* Figma: pt14 pb10 px40 */
    border-radius: 2px;
    background: var(--color-burgundy);
    color: var(--color-cream);
    font-family: 'Gascogne', serif;
    font-weight: 300;          /* Figma: Light */
    font-size: 20px;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .jkl-404__title {
      font-size: 40px;
    }
  }
</style>

