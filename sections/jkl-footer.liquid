{%- assign show_cancel_order = true -%}
{%- if section.settings.show_cancel_order == false -%}
  {%- assign show_cancel_order = false -%}
{%- endif -%}

<footer class="site-footer bg-burgundy color-cream">
   {% if show_cancel_order %}
        {%- render 'cancel-order-modal' -%}
      {% endif %}
  <div class="footer-logo">
    <img src="{{ 'jkl-logo-footer.png' | asset_url }}" alt="JKL">
    <p class="footer-address">JKL II ApS<br>Strandvejen 60<br>2900 Hellerup</p>
    <p class="footer-address">+45 4011 9760<br>db@jklfinewines.com</p>
    <p class="footer-address">CVR-nr.: 45966380</p>
  </div>
  <div class="footer-columns">
    <div class="footer-column">
      <h3 class="column-title">{{ 'jkl.footer_customer_service' | t }}</h3>
      <ul class="column-links">
        <li><a href="/pages/contact">{{ 'jkl.footer_contact' | t }}</a></li>
        <li><a href="/policies/shipping-policy">{{ 'jkl.footer_shipping_delivery' | t }}</a></li>
        <li><a href="/pages/faq">{{ 'jkl.footer_help_faq' | t }}</a></li>
        {% if show_cancel_order %}
          <li><a href="#cancel-order-modal" class="js-open-modal open-ordre__customer" data-action="open-modal" data-modal-id="cancel-order-modal" aria-controls="cancel-order-modal">{{ 'jkl.footer_cancel_order' | t }}</a></li>
        {% endif %}
      </ul>
    </div>
    <div class="footer-column">
      <h3 class="column-title">JKL Club</h3>
      <ul class="column-links">
        <li><a href="/pages/bliv-medlem">{{ 'jkl.footer_join_club' | t }}</a></li>
        <li><a href="/pages/bliv-medlem">{{ 'jkl.footer_member_benefits' | t }}</a></li>
        <li><a href="/account">{{ 'jkl.footer_login' | t }}</a></li>
      </ul>
    </div>
    <div class="footer-column">
      <h3 class="column-title">JKL Fine Wines</h3>
      <ul class="column-links">
        <li><a href="/pages/bygget-pa-30-ars-erfaring-med-fine-wine">{{ 'jkl.footer_our_story' | t }}</a></li>
        <li><a href="/collections/vinproducenter">{{ 'jkl.footer_our_producers' | t }}</a></li>
      </ul>
    </div>
    <div class="footer-column">
      <h3 class="column-title">{{ 'jkl.footer_follow_us' | t }}</h3>
      <ul class="column-links">
        <li><a href="https://www.instagram.com/jklfinewines.se" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.facebook.com/people/JKLfinewinesse/61584163708688/" target="_blank" rel="noopener">Facebook</a></li>
        <li><a href="#">{{ 'jkl.footer_newsletter' | t }}</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-contact">
    <p>+45 7010 2020</p>
    <p>Monday-thursday 9:00-16:00</p>
    <p>Friday 9:00-15:00</p>
  </div>
  <div class="footer-bottom">
    <div class="payment-icons">
      <img src="{{ 'jkl-payment-apple.png' | asset_url }}" alt="Apple Pay">
      <img src="{{ 'jkl-payment-google.png' | asset_url }}" alt="Google Pay">
      <img src="{{ 'jkl-payment-mastercard.png' | asset_url }}" alt="Mastercard">
      <img src="{{ 'jkl-payment-visa.png' | asset_url }}" alt="Visa">
      <img src="{{ 'jkl-payment-paypal.png' | asset_url }}" alt="PayPal">
      <img src="{{ 'jkl-payment-shop.png' | asset_url }}" alt="Shop Pay">
      <img src="{{ 'jkl-payment-klarna.png' | asset_url }}" alt="Klarna">
    </div>
    <ul class="footer-legal">
      <li><a href="{{ shop.terms_of_service.url }}">{{ 'jkl.terms_and_conditions' | t }}</a></li>
      <li><a href="{{ shop.privacy_policy.url }}">{{ 'jkl.privacy_policy' | t }}</a></li>
    </ul>
  </div>
</footer>

{% schema %}
{
  "name": "JKL Footer",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cancel_order",
      "label": "Show cancel order link",
      "default": true
    }
  ],
  "presets": []
}
{% endschema %}
