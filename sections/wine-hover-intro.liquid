{{ 'wine-hover-intro.css' | asset_url | stylesheet_tag }}

<div class="wine-hover-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="wine-hover-inner">
    <p class="wine-hover-text" style="color: {{ section.settings.text_color }};">
      {{ section.settings.intro_prefix | strip }}
      {% for block in section.blocks -%}
        {%- assign is_last = forloop.last -%}
        {%- assign col = block.settings.collection -%}
        {%- if col != blank and col.image != blank -%}
          {%- assign bottle_image = col.image | image_url: width: 300 -%}
        {%- elsif col != blank and col.products.first.featured_image != blank -%}
          {%- assign bottle_image = col.products.first.featured_image | image_url: width: 300 -%}
        {%- else -%}
          {%- assign bottle_image = block.settings.fallback_image | image_url: width: 300 -%}
        {%- endif -%}
        <a
          href="{{ col.url | default: block.settings.link | default: '#' }}"
          class="wine-hover-word"
          data-image="{{ bottle_image }}"
          style="{% if block.settings.word_color != blank %}color: {{ block.settings.word_color }};{% endif %}"
          {{ block.shopify_attributes }}
        >{{ block.settings.label | default: col.title }}</a>{%- unless is_last -%}{%- if forloop.rindex == 2 -%} {{ section.settings.last_separator | strip }} {%- else -%}, {%- endif -%}{%- endunless -%}
      {%- endfor %}
      {{ section.settings.intro_suffix | strip }}
    </p>
  </div>

  <!-- Floating bottle image that follows the cursor -->
  <img class="wine-hover-bottle" src="" alt="" aria-hidden="true">
</div>

<script src="{{ 'wine-hover-intro.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Wine hover intro",
  "settings": [
    {
      "type": "text",
      "id": "intro_prefix",
      "label": "Text before the word list",
      "default": "Explore a curated world of wine, including"
    },
    {
      "type": "text",
      "id": "intro_suffix",
      "label": "Text after the word list",
      "default": "and more."
    },
    {
      "type": "text",
      "id": "last_separator",
      "label": "Separator before last word",
      "default": " and "
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F8F0DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2B2118"
    }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Hover word",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Word (leave blank to use collection title)",
          "default": "Red"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Link + hover image are pulled from this collection automatically"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (only used if no collection is selected)"
        },
        {
          "type": "color",
          "id": "word_color",
          "label": "Word color (optional accent, e.g. for Rosé)"
        },
        {
          "type": "image_picker",
          "id": "fallback_image",
          "label": "Fallback bottle image",
          "info": "Used only if the collection has no image and no products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wine hover intro",
      "blocks": [
        { "type": "word" },
        { "type": "word", "settings": { "word_color": "#C9A66B" } },
      ]
    }
  ]
}
{% endschema %}
