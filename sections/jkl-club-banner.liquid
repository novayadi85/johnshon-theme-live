{%- liquid
  # Sproghåndtering ligger i sektionen: ét felt pr. sprog pr. tekst, valgt ud fra
  # det aktive storefront-sprog. Ingen fallback — er feltet tomt, udelades teksten.
  assign lang = request.locale.iso_code

  assign key = 'info_text_' | append: lang
  assign info_text = section.settings[key]

  assign key = 'link_label_' | append: lang
  assign link_label = section.settings[key]

  assign key = 'tag_' | append: lang
  assign tag_text = section.settings[key]

  assign key = 'title_' | append: lang
  assign section_title = section.settings[key]

  assign key = 'benefit_1_' | append: lang
  assign benefit_1 = section.settings[key]

  assign key = 'benefit_2_' | append: lang
  assign benefit_2 = section.settings[key]

  assign key = 'benefit_3_' | append: lang
  assign benefit_3 = section.settings[key]
-%}
{%- comment -%}
  Ét ord i sætningen er et link. I stedet for at lade redaktøren skrive HTML
  bruges samme pladsholder-konvention som temaets sprogfiler (jkl.accept_terms
  bruger samme idé): teksten skriver "Join the [link] for free", og selve
  linkteksten står i sit eget felt.
{%- endcomment -%}
{%- capture club_anchor -%}
  {%- if link_label != blank -%}
    <a href="{{ section.settings.club_link | default: '#' }}">{{ link_label }}</a>
  {%- endif -%}
{%- endcapture -%}
{%- assign info_html = info_text | replace: '[link]', club_anchor | strip -%}
<section class="club-banner bg-green-coal color-green-gold">
  <div class="bg-logo">
    <img src="{{ 'jkl-logo-background.png' | asset_url }}" alt="">
  </div>
  <div class="divider-border">

  </div>
  <div class="content">
    <div class="section-info">
      {%- if info_html != blank or tag_text != blank -%}
        <div class="info-row">
          {%- if info_html != blank -%}
            <span class="info-text">{{ info_html }}</span>
          {%- endif -%}
          {%- if tag_text != blank -%}
            <span class="tag">{{ tag_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section_title != blank -%}
        <h2 class="title">{{ section_title }}</h2>
      {%- endif -%}
    </div>
    <div class="benefits">
      {%- if benefit_1 != blank -%}
        <div class="benefit-item">
          <img src="{{ 'check_jkl.svg' | asset_url }}" alt="✓">
          <span>{{ benefit_1 }}</span>
        </div>
      {%- endif -%}
      {%- if benefit_2 != blank -%}
        <div class="benefit-item">
          <img src="{{ 'check_jkl.svg' | asset_url }}" alt="✓">
          <span>{{ benefit_2 }}</span>
        </div>
      {%- endif -%}
      {%- if benefit_3 != blank -%}
        <div class="benefit-item">
          <img src="{{ 'check_jkl.svg' | asset_url }}" alt="✓">
          <span>{{ benefit_3 }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- assign customer_membership = customer.metafields.custom.membership.value -%}
    {%- assign customer_has_tickets = customer.metafields.custom.has_tickets.value | default: customer.metafields.custom.has_tickets -%}
    {%- assign is_club_member = false -%}
    {%- if customer.tags contains 'bronze' -%}
      {%- assign is_club_member = true -%}
    {%- endif -%}
 
    {% if is_club_member %}
      <!-- Besked til eksisterende medlemmer -->
      <div class="jkl-member-message">
        <p>🎉 <strong>Tak!</strong> Du er allerede tilmeldt JKL Club som Bronze-medlem. Nyd dine eksklusive fordele!</p>
      </div>
    {% else %}
      <!-- Tilmeldingsformular for ikke-medlemmer -->
      {% render 'jkl-signup-form',
        customer_tags_endpoint: '/apps/communication',
        customer_tags_tag: 'bronze',
        customer_tags_action: 'add' 
      %}
    {% endif %}

  </div>
</section>

