<section class="club-banner bg-green-coal color-green-gold">
  <div class="bg-logo">
    <img src="{{ 'jkl-logo-background.png' | asset_url }}" alt="">
  </div>
  <div class="divider-border">
    
  </div>
  <div class="content">
    <div class="section-info">
      <div class="info-row">
        <span class="info-text">Join the <a href="#">JKL Club</a> for free</span>
        <span class="tag">Save 20% on your first order</span>
      </div>
      <h2 class="title">Get member pricing, early access, and curated selections.</h2>
    </div>
    <div class="benefits">
      <div class="benefit-item">
        <img src="{{ 'check_jkl.svg' | asset_url }}" alt="✓">
        <span>Member pricing on selected wines</span>
      </div>
      <div class="benefit-item">
        <img src="{{ 'check_jkl.svg' | asset_url }}" alt="✓">
        <span>Early access to limited bottles and small allocations</span>
      </div>
      <div class="benefit-item">
        <img src="{{ 'check_jkl.svg' | asset_url }}" alt="✓">
        <span>Curated tasting selections tailored to the season</span>
      </div>
    </div>
    
    {% if customer.tags contains 'bronze' %}
      <!-- Besked til eksisterende medlemmer -->
      <div class="jkl-member-message">
        <p>🎉 <strong>Tak!</strong> Du er allerede tilmeldt JKL Club som Bronze-medlem. Nyd dine eksklusive fordele!</p>
      </div>
    {% else %}
      <!-- Tilmeldingsformular for ikke-medlemmer -->
      {% render 'jkl-signup-form',
        customer_tags_endpoint: 'https://shop-helper.dev.shopadjust-apps.com/apps/customer/tags',
        customer_tags_tag: 'bronze',
        customer_tags_action: 'add'
      %}
    {% endif %}
    
  </div>
</section>

{% schema %}
{
  "name": "JKL Club Banner",
  "tag": "section",
  "class": "jkl-club-banner-section",
  "settings": [],
  "presets": [
    {
      "name": "JKL Club Banner"
    }
  ]
}
{% endschema %}
