
{%- assign block_settings = block.settings -%}
<button
  type="submit"
  class="button submit-button size-style {{ block_settings.style_class }}"
  style="{% render 'size-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
</button>

{% stylesheet %}
  .submit-button {
    min-width: max-content;
  }

  /* JKL: knappen foelger temaets eget knap-idiom frem for Horizons skema-
     styling — samme maal og typografi som .signup-form-btn, der er den anden
     formular-submit i temaet. Scopet til .contact-form, saa andre
     submit-knapper er upaavirkede. */
  .contact-form .submit-button {
    height: 45px;
    padding: 0 40px;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 20px;
    line-height: 1;
    border-radius: 2px;
    background-color: var(--color-green-coal);
    border: 1px solid var(--color-green-coal);
    color: var(--color-cream);
    text-transform: none;
    cursor: pointer;
    transition: opacity var(--transition);
  }

  .contact-form .submit-button:hover {
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.submit_button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.contact_form_button_label"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ],
  "presets": []
}
{% endschema %}
